<!-- Full-bleed collection banner -->
<div class="collection-banner">
  {%- if collection.image -%}
    {{
      collection.image
      | image_url: width: 1600
      | image_tag:
        loading: 'eager',
        sizes: '100vw',
        alt: collection.title
    }}
  {%- else -%}
    <img
      src="{{ 'collection-banner.png' | asset_url }}"
      loading="eager"
      fetchpriority="high"
      style="width:100%;height:100%;object-fit:cover;object-position:center top;"
      alt="{{ collection.title }}"
    >
  {%- endif -%}
  <div class="collection-banner__content">
    <div class="container">
      <h1 class="text-h1 collection-banner__title" data-reveal>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p style="color:rgba(255,255,255,0.7);max-width:50ch;margin-top:12px;" data-reveal data-reveal-delay="1">
          {{ collection.description }}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- Toolbar / filters -->
<div class="collection-header">
  <div class="container">
    <div class="collection-toolbar">
      <span style="font-size:0.8125rem;font-weight:600;color:var(--c-text-3);">
        {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}
      </span>

      <form id="sort-form" method="get" style="display:flex;align-items:center;gap:8px;">
        {%- if current_tags.size > 0 -%}
          {%- for tag in current_tags -%}
            <input type="hidden" name="q[]" value="{{ tag | escape }}">
          {%- endfor -%}
        {%- endif -%}
        <label class="text-xs" style="color:var(--c-text-3);">Sort:</label>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <div class="sort-dropdown" id="sort-dropdown">
          <button class="sort-dropdown__trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
            <span class="sort-dropdown__current">
              {%- case sort_by -%}
                {%- when 'best-selling' -%}Best Selling
                {%- when 'created-descending' -%}Newest
                {%- when 'price-ascending' -%}Price: Low → High
                {%- when 'price-descending' -%}Price: High → Low
                {%- when 'title-ascending' -%}A → Z
                {%- when 'title-descending' -%}Z → A
                {%- else -%}Featured
              {%- endcase -%}
            </span>
            <svg class="sort-dropdown__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul class="sort-dropdown__menu" role="listbox" aria-label="Sort order">
            <li role="option" class="sort-dropdown__option{% if sort_by == 'manual' or sort_by == blank %} is-active{% endif %}" data-value="manual">Featured</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'best-selling' %} is-active{% endif %}" data-value="best-selling">Best Selling</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'created-descending' %} is-active{% endif %}" data-value="created-descending">Newest</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'price-ascending' %} is-active{% endif %}" data-value="price-ascending">Price: Low → High</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'price-descending' %} is-active{% endif %}" data-value="price-descending">Price: High → Low</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'title-ascending' %} is-active{% endif %}" data-value="title-ascending">A → Z</li>
            <li role="option" class="sort-dropdown__option{% if sort_by == 'title-descending' %} is-active{% endif %}" data-value="title-descending">Z → A</li>
          </ul>
          <input type="hidden" name="sort_by" class="sort-dropdown__input" value="{{ sort_by }}">
        </div>
      </form>
    </div>

    <!-- Tag filter chips -->
    {%- if collection.all_tags.size > 0 -%}
      <div class="collection-filters" role="navigation" aria-label="Product filters" style="margin-bottom:var(--space-xl);">
        {%- for tag in collection.all_tags -%}
          {%- if current_tags contains tag -%}
            <a href="{{ collection.url }}" class="filter-chip active" aria-pressed="true">{{ tag }}</a>
          {%- else -%}
            {{ tag | link_to_tag: tag | replace: '<a ', '<a class="filter-chip" ' }}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="container" style="padding-bottom: var(--space-3xl);">
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="products-grid" role="list" aria-label="Products">
        {%- for product in collection.products -%}
          <div role="listitem"{% if forloop.first %} class="product-card-featured-wrap"{% endif %} data-reveal data-reveal-delay="{{ forloop.index | modulo: 4 }}">
            {%- render 'product-card', product: product -%}
          </div>
          {%- assign mod_check = forloop.index | modulo: 8 -%}
          {%- if mod_check == 0 and forloop.last == false -%}
            <div class="collection-brand-strip">
              WHERE SPEED MEETS STYLE &nbsp;&middot;&nbsp; COURT TO STREET &nbsp;&middot;&nbsp; BQUIK SS25 &nbsp;&middot;&nbsp; MOVE FAST. PLAY SHARP.
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination" style="display:flex;justify-content:center;gap:8px;margin-top:var(--space-2xl);">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn-secondary">← Prev</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="btn btn-secondary" style="min-width:44px;">{{ part.title }}</a>
            {%- else -%}
              <span class="btn btn-primary" style="min-width:44px;" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn-secondary">Next →</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty" style="text-align:center;padding:var(--space-3xl) 0;">
        <p style="color:var(--c-text-2);font-size:1.25rem;margin-bottom:24px;">No products found.</p>
        <a href="{{ routes.root_url }}" class="btn btn-primary">Back to Home</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>
