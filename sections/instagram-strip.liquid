{%- liquid
  assign heading = section.settings.heading | default: 'Community'
  assign subheading = section.settings.subheading | default: '#BQUIKVOLLEY'
  assign instagram_url = section.settings.instagram_url
  assign block_count = section.blocks.size
  assign fallback_images = 'instagram-strip-1.png,instagram-strip-2.png,instagram-strip-3.png,instagram-strip-4.png' | split: ','
-%}

{%- if block_count > 0 -%}
<section class="instagram-strip" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="instagram-strip__header" data-reveal>
      <div>
        <h2 class="text-h2 instagram-strip__title">{{ heading }}</h2>
        {%- if subheading != blank -%}
          <p class="instagram-strip__hashtag">{{ subheading }}</p>
        {%- endif -%}
      </div>
      {%- if instagram_url != blank -%}
        <a href="{{ instagram_url }}" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">
          Follow Us
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="instagram-strip__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'photo' -%}
        <a
          class="instagram-strip__item"
          href="{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif instagram_url != blank -%}{{ instagram_url }}{%- else -%}#{%- endif -%}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ block.settings.caption | default: 'View on Instagram' | escape }}"
          data-reveal
          data-reveal-delay="{{ forloop.index | modulo: 6 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width:1400px) 16.66vw, (min-width:768px) 25vw, 50vw',
                alt: block.settings.caption | default: 'BQUIK community photo'
            }}
          {%- else -%}
            {%- assign fallback_idx = forloop.index0 | modulo: 4 -%}
            <img
              src="{{ fallback_images[fallback_idx] | asset_url }}"
              loading="lazy"
              class="instagram-strip__photo"
              style="width:100%;height:100%;object-fit:cover;"
              alt="BQUIK community photo"
            >
          {%- endif -%}
          <div class="instagram-strip__overlay" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            {%- if block.settings.caption != blank -%}
              <span class="instagram-strip__caption">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram / UGC Strip",
  "tag": "section",
  "class": "section-instagram-strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Hashtag / subheading",
      "default": "#BQUIKVOLLEY"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional — overrides profile URL)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Instagram / UGC Strip",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
